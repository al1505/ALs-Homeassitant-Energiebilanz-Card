{
  "name": "bankconvertierer",
  "version": "1.0.0",
  "description": "Konvertiert SEPA Direct Debit XML von pain.008.001.01 (österreichisches STUZZA-Format) nach pain.008.001.08",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:win":   "pkg index.js --targets node22-win-x64   --output dist/Bankconvertierer.exe   --public",
    "build:linux": "pkg index.js --targets node22-linux-x64 --output dist/Bankconvertierer-linux --public",
    "build:all":   "npm run build:win && npm run build:linux"
  },
  "pkg": {
    "scripts": [],
    "assets": [],
    "targets": [
      "node22-win-x64"
    ]
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "fast-xml-parser": "^4.3.6",
    "xmlbuilder2": "^3.1.1"
  }
}
